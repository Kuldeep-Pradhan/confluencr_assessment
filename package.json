{
  "name": "transaction-ledger-service",
  "version": "1.0.0",
  "description": "High-reliability transaction ledger backend API built with Node.js, TypeScript, and Express",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/build.mjs",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "test": "node scripts/test.mjs all",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "docs:validate": "tsx scripts/validate-openapi.ts"
  },
  "keywords": [
    "ledger",
    "transaction",
    "accounting",
    "express",
    "typescript"
  ],
  "author": "Kuldeep-Pradhan",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
