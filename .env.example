# Copy this file to .env. These credentials are for LOCAL development only.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Docker Desktop publishes PostgreSQL on loopback only, port 5433.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_local_password
POSTGRES_DB=transaction_ledger
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ledger:ledger_local_password@localhost:5433/transaction_ledger
# Must be a DIFFERENT database with a name ending in _test. Tests never truncate data.
TEST_DATABASE_URL=postgresql://ledger:ledger_local_password@localhost:5433/transaction_ledger_test
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# Comma-separated allowed browser origins. No wildcard by default.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
